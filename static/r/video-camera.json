form: scale(1);\n    }\n    50% {\n      transform: scale(1.05);\n    }\n  }\n\n  @keyframes videocamera-blink {\n    0%,\n    100% {\n      opacity: 0;\n    }\n    25% {\n      opacity: 1;\n    }\n    50% {\n      opacity: 0;\n    }\n    75% {\n      opacity: 1;\n    }\n  }\n</style>\n",
