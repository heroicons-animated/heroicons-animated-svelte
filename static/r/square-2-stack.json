ransform: translate(0, 0);\n  }\n\n  .square2stack-front.square2stack-front-animate {\n    animation: square2stack-front 0.3s ease-in-out forwards;\n  }\n\n  @keyframes square2stack-front {\n    0%,\n    100% {\n      transform: translate(0, 0);\n    }\n    50% {\n      transform: translate(1px, 1px);\n    }\n  }\n</style>\n",
