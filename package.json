{
  "name": "@heroicons-animated/svelte",
  "version": "1.2.3",
  "description": "Beautifully animated Heroicons for Svelte",
  "author": "Aniket-508",
  "license": "MIT",
  "homepage": "https://svelte.heroicons-animated.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroicons-animated/heroicons-animated-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/heroicons-animated/heroicons-animated-svelte/issues"
  },
  "keywords": [
    "heroicons",
    "svelte",
    "svelte5",
    "icons",
    "animated",
    "css-animations",
    "sveltekit"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte",
      "import": "./dist/icons/*.svelte",
      "default": "./dist/icons/*.svelte"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/icons/*.svelte.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite dev",
    "build:site": "pnpm run build-registry && vite build",
    "build:lib": "svelte-package",
    "build": "pnpm run build:lib && pnpm run build:site",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "type-check:site": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check:lib": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "type-check": "pnpm run type-check:lib && pnpm run type-check:site",
    "build-registry": "node scripts/registry-build.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@internationalized/date": "^3.11.0",
    "@number-flow/svelte": "^0.3.10",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/package": "^2.3.4",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@toolwind/corner-shape": "0.0.8-3",
    "@types/umami-browser": "^2.18.0",
    "bits-ui": "^2.15.5",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "geist-svelte": "^1.0.0",
    "mode-watcher": "^1.1.0",
    "nuqs-svelte": "^1.2.2",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "svelte-meta-tags": "^4.5.0",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "7.1.5",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.x"
  },
  "packageManager": "pnpm@10.28.0"
}
